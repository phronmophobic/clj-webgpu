e_TextureAndSamplerLet", :type "CXType_Int", :name "WGPUWGSLLanguageFeatureName_TextureAndSamplerLet", :value 7, :enum "WGPUWGSLLanguageFeatureName", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUWGSLLanguageFeatureName_SubgroupUniformity", :type "CXType_Int", :name "WGPUWGSLLanguageFeatureName_SubgroupUniformity", :value 8, :enum "WGPUWGSLLanguageFeatureName", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUWGSLLanguageFeatureName_TextureFormatsTier1", :type "CXType_Int", :name "WGPUWGSLLanguageFeatureName_TextureFormatsTier1", :value 9, :enum "WGPUWGSLLanguageFeatureName", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUWGSLLanguageFeatureName_LinearIndexing", :type "CXType_Int", :name "WGPUWGSLLanguageFeatureName_LinearIndexing", :value 10, :enum "WGPUWGSLLanguageFeatureName", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUWGSLLanguageFeatureName_Force32", :type "CXType_Int", :name "WGPUWGSLLanguageFeatureName_Force32", :value 2147483647, :enum "WGPUWGSLLanguageFeatureName", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_DeviceExtras", :type "CXType_Int", :name "WGPUSType_DeviceExtras", :value 196609, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUDeviceExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_NativeLimits", :type "CXType_Int", :name "WGPUSType_NativeLimits", :value 196610, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUNativeLimits. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_ShaderSourceGLSL", :type "CXType_Int", :name "WGPUSType_ShaderSourceGLSL", :value 196611, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUShaderSourceGLSL. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_InstanceExtras", :type "CXType_Int", :name "WGPUSType_InstanceExtras", :value 196612, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUInstanceExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_BindGroupEntryExtras", :type "CXType_Int", :name "WGPUSType_BindGroupEntryExtras", :value 196613, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUBindGroupEntryExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_BindGroupLayoutEntryExtras", :type "CXType_Int", :name "WGPUSType_BindGroupLayoutEntryExtras", :value 196614, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUBindGroupLayoutEntryExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_QuerySetDescriptorExtras", :type "CXType_Int", :name "WGPUSType_QuerySetDescriptorExtras", :value 196615, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUQuerySetDescriptorExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_SurfaceConfigurationExtras", :type "CXType_Int", :name "WGPUSType_SurfaceConfigurationExtras", :value 196616, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUSurfaceConfigurationExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_SurfaceSourceSwapChainPanel", :type "CXType_Int", :name "WGPUSType_SurfaceSourceSwapChainPanel", :value 196617, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUSurfaceSourceSwapChainPanel. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_PrimitiveStateExtras", :type "CXType_Int", :name "WGPUSType_PrimitiveStateExtras", :value 196618, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUPrimitiveStateExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_SamplerDescriptorExtras", :type "CXType_Int", :name "WGPUSType_SamplerDescriptorExtras", :value 196619, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUSamplerDescriptorExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeSType_Force32", :type "CXType_Int", :name "WGPUNativeSType_Force32", :value 2147483647, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUSamplerDescriptorExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_DeviceExtras", :type "CXType_Int", :name "WGPUSType_DeviceExtras", :value 196609, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUDeviceExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_NativeLimits", :type "CXType_Int", :name "WGPUSType_NativeLimits", :value 196610, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUNativeLimits. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_ShaderSourceGLSL", :type "CXType_Int", :name "WGPUSType_ShaderSourceGLSL", :value 196611, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUShaderSourceGLSL. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_InstanceExtras", :type "CXType_Int", :name "WGPUSType_InstanceExtras", :value 196612, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUInstanceExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_BindGroupEntryExtras", :type "CXType_Int", :name "WGPUSType_BindGroupEntryExtras", :value 196613, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUBindGroupEntryExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_BindGroupLayoutEntryExtras", :type "CXType_Int", :name "WGPUSType_BindGroupLayoutEntryExtras", :value 196614, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUBindGroupLayoutEntryExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_QuerySetDescriptorExtras", :type "CXType_Int", :name "WGPUSType_QuerySetDescriptorExtras", :value 196615, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUQuerySetDescriptorExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_SurfaceConfigurationExtras", :type "CXType_Int", :name "WGPUSType_SurfaceConfigurationExtras", :value 196616, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUSurfaceConfigurationExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_SurfaceSourceSwapChainPanel", :type "CXType_Int", :name "WGPUSType_SurfaceSourceSwapChainPanel", :value 196617, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUSurfaceSourceSwapChainPanel. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_PrimitiveStateExtras", :type "CXType_Int", :name "WGPUSType_PrimitiveStateExtras", :value 196618, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUPrimitiveStateExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSType_SamplerDescriptorExtras", :type "CXType_Int", :name "WGPUSType_SamplerDescriptorExtras", :value 196619, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUSamplerDescriptorExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeSType_Force32", :type "CXType_Int", :name "WGPUNativeSType_Force32", :value 2147483647, :enum "WGPUNativeSType", :raw-comment "/** Identifies @ref WGPUSamplerDescriptorExtras. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSurfaceGetCurrentTextureStatus_Occluded", :type "CXType_Int", :name "WGPUSurfaceGetCurrentTextureStatus_Occluded", :value 196609, :enum "WGPUNativeSurfaceGetCurrentTextureStatus", :raw-comment "/**\n     * The surface texture was not acquired because the window is occluded\n     * (e.g. minimized or fully covered by another window).\n     *\n     * No texture is returned and the @c texture field of\n     * @c WGPUSurfaceTexture will be NULL. The surface and swapchain remain\n     * valid -- there is no need to reconfigure or recreate the surface.\n     *\n     * Applications should skip rendering for the current frame and try\n     * again once the window is no longer occluded. If you are using a\n     * windowing library such as winit, listen for the window's \"occluded\"\n     * event and request a new redraw when the window becomes visible again.\n     *\n     * When does this occur?\n     *\n     * Currently this status is only produced by the Metal backend on macOS.\n     * When a window is not visible (checked via the @c NSWindow\n     * @c occlusionState property), acquiring the next drawable would block\n     * for up to one second waiting for vsync. wgpu-native returns\n     * @c Occluded instead to avoid that hang.\n     *\n     * Other backends (Vulkan, DX12, GL) do not currently report this\n     * status; an occluded window on those backends may produce\n     * @c WGPUSurfaceGetCurrentTextureStatus_Timeout or simply succeed\n     * normally.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeSurfaceGetCurrentTextureStatus_Force32", :type "CXType_Int", :name "WGPUNativeSurfaceGetCurrentTextureStatus_Force32", :value 2147483647, :enum "WGPUNativeSurfaceGetCurrentTextureStatus", :raw-comment "/**\n     * The surface texture was not acquired because the window is occluded\n     * (e.g. minimized or fully covered by another window).\n     *\n     * No texture is returned and the @c texture field of\n     * @c WGPUSurfaceTexture will be NULL. The surface and swapchain remain\n     * valid -- there is no need to reconfigure or recreate the surface.\n     *\n     * Applications should skip rendering for the current frame and try\n     * again once the window is no longer occluded. If you are using a\n     * windowing library such as winit, listen for the window's \"occluded\"\n     * event and request a new redraw when the window becomes visible again.\n     *\n     * When does this occur?\n     *\n     * Currently this status is only produced by the Metal backend on macOS.\n     * When a window is not visible (checked via the @c NSWindow\n     * @c occlusionState property), acquiring the next drawable would block\n     * for up to one second waiting for vsync. wgpu-native returns\n     * @c Occluded instead to avoid that hang.\n     *\n     * Other backends (Vulkan, DX12, GL) do not currently report this\n     * status; an occluded window on those backends may produce\n     * @c WGPUSurfaceGetCurrentTextureStatus_Timeout or simply succeed\n     * normally.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUSurfaceGetCurrentTextureStatus_Occluded", :type "CXType_Int", :name "WGPUSurfaceGetCurrentTextureStatus_Occluded", :value 196609, :enum "WGPUNativeSurfaceGetCurrentTextureStatus", :raw-comment "/**\n     * The surface texture was not acquired because the window is occluded\n     * (e.g. minimized or fully covered by another window).\n     *\n     * No texture is returned and the @c texture field of\n     * @c WGPUSurfaceTexture will be NULL. The surface and swapchain remain\n     * valid -- there is no need to reconfigure or recreate the surface.\n     *\n     * Applications should skip rendering for the current frame and try\n     * again once the window is no longer occluded. If you are using a\n     * windowing library such as winit, listen for the window's \"occluded\"\n     * event and request a new redraw when the window becomes visible again.\n     *\n     * When does this occur?\n     *\n     * Currently this status is only produced by the Metal backend on macOS.\n     * When a window is not visible (checked via the @c NSWindow\n     * @c occlusionState property), acquiring the next drawable would block\n     * for up to one second waiting for vsync. wgpu-native returns\n     * @c Occluded instead to avoid that hang.\n     *\n     * Other backends (Vulkan, DX12, GL) do not currently report this\n     * status; an occluded window on those backends may produce\n     * @c WGPUSurfaceGetCurrentTextureStatus_Timeout or simply succeed\n     * normally.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeSurfaceGetCurrentTextureStatus_Force32", :type "CXType_Int", :name "WGPUNativeSurfaceGetCurrentTextureStatus_Force32", :value 2147483647, :enum "WGPUNativeSurfaceGetCurrentTextureStatus", :raw-comment "/**\n     * The surface texture was not acquired because the window is occluded\n     * (e.g. minimized or fully covered by another window).\n     *\n     * No texture is returned and the @c texture field of\n     * @c WGPUSurfaceTexture will be NULL. The surface and swapchain remain\n     * valid -- there is no need to reconfigure or recreate the surface.\n     *\n     * Applications should skip rendering for the current frame and try\n     * again once the window is no longer occluded. If you are using a\n     * windowing library such as winit, listen for the window's \"occluded\"\n     * event and request a new redraw when the window becomes visible again.\n     *\n     * When does this occur?\n     *\n     * Currently this status is only produced by the Metal backend on macOS.\n     * When a window is not visible (checked via the @c NSWindow\n     * @c occlusionState property), acquiring the next drawable would block\n     * for up to one second waiting for vsync. wgpu-native returns\n     * @c Occluded instead to avoid that hang.\n     *\n     * Other backends (Vulkan, DX12, GL) do not currently report this\n     * status; an occluded window on those backends may produce\n     * @c WGPUSurfaceGetCurrentTextureStatus_Timeout or simply succeed\n     * normally.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_Immediates", :type "CXType_Int", :name "WGPUNativeFeature_Immediates", :value 196609, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the use of immediate data: small, fast blocks of memory\n     * that can be updated inside a render pass, compute pass, or render\n     * bundle encoder.\n     *\n     * Enables @ref wgpuRenderPassEncoderSetImmediates,\n     * @ref wgpuComputePassEncoderSetImmediates,\n     * @ref wgpuRenderBundleEncoderSetImmediates,\n     * non-zero @c immediateSize in @ref WGPUPipelineLayout,\n     * and non-zero @c maxImmediateSize in @ref WGPULimits.\n     *\n     * A block of immediate data can be declared in WGSL with\n     * @c var<immediate>:\n     * @code\n     * struct Immediates { example: f32, }\n     * var<immediate> c: Immediates;\n     * @endcode\n     *\n     * In GLSL, this corresponds to @c layout(immediates) @c uniform @c Name @c {..}.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     * - Metal\n     * - OpenGL (emulated with uniforms)\n     * - WebGPU\n     *\n     * This is a web and native feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureAdapterSpecificFormatFeatures", :type "CXType_Int", :name "WGPUNativeFeature_TextureAdapterSpecificFormatFeatures", :value 196610, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables device-specific texture format features.\n     *\n     * By default only texture format properties as defined by the WebGPU\n     * specification are allowed. Enabling this feature flag extends the\n     * features of each format to the ones supported by the current device.\n     * Note that without this flag, read/write storage access is not allowed\n     * at all.\n     *\n     * This extension does not enable additional formats.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MultiDrawIndirectCount", :type "CXType_Int", :name "WGPUNativeFeature_MultiDrawIndirectCount", :value 196612, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the use of a buffer containing the actual number of draw calls.\n     *\n     * Enables @ref wgpuRenderPassEncoderMultiDrawIndirectCount and\n     * @ref wgpuRenderPassEncoderMultiDrawIndexedIndirectCount.\n     *\n     * This feature being present also implies that all calls to\n     * @ref wgpuRenderPassEncoderMultiDrawIndirect and\n     * @ref wgpuRenderPassEncoderMultiDrawIndexedIndirect are not being\n     * emulated with a series of @c draw_indirect calls.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan 1.2+ (or VK_KHR_draw_indirect_count)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_VertexWritableStorage", :type "CXType_Int", :name "WGPUNativeFeature_VertexWritableStorage", :value 196613, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables bindings of writable storage buffers and textures visible\n     * to vertex shaders.\n     *\n     * Note: some (tiled-based) platforms do not support vertex shaders\n     * with any side-effects.\n     *\n     * Supported platforms:\n     * - All\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_TextureBindingArray", :value 196614, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create uniform arrays of textures in shaders:\n     *\n     * - WGSL: @c var @c textures: @c binding_array<texture_2d<f32>, @c 10>\n     * - GLSL: @c uniform @c texture2D @c textures[10]\n     *\n     * If @ref WGPUNativeFeature_StorageResourceBindingArray is supported\n     * as well as this, the user may also create uniform arrays of storage\n     * textures.\n     *\n     * This capability allows them to exist and to be indexed by dynamically\n     * uniform values.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Metal (with MSL 2.0+ on macOS 10.13+)\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_SampledTextureAndStorageBufferArrayNonUniformIndexing", :type "CXType_Int", :name "WGPUNativeFeature_SampledTextureAndStorageBufferArrayNonUniformIndexing", :value 196615, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to index sampled texture and storage buffer resource\n     * arrays with dynamically non-uniform values:\n     *\n     * e.g. @c texture_array[vertex_data]\n     *\n     * In order to use this capability, the corresponding GLSL extension must\n     * be enabled:\n     *\n     * @c \\#extension @c GL_EXT_nonuniform_qualifier @c : @c require\n     *\n     * and then used either as @c nonuniformEXT qualifier in variable\n     * declaration or as @c nonuniformEXT constructor.\n     *\n     * WGSL and HLSL do not need any extension.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Metal (with MSL 2.0+ on macOS 10.13+)\n     * - Vulkan 1.2+ (or VK_EXT_descriptor_indexing)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PipelineStatisticsQuery", :type "CXType_Int", :name "WGPUNativeFeature_PipelineStatisticsQuery", :value 196616, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables use of Pipeline Statistics Queries. These queries report the\n     * count of various operations performed between the start and stop call.\n     *\n     * Use @ref wgpuRenderPassEncoderBeginPipelineStatisticsQuery /\n     * @ref wgpuRenderPassEncoderEndPipelineStatisticsQuery (or the compute\n     * pass equivalents) to start and stop a query.\n     *\n     * They must be resolved using @c wgpuCommandEncoderResolveQuerySet into\n     * a buffer. See @ref WGPUPipelineStatisticName for the list of available\n     * statistics.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_StorageResourceBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_StorageResourceBindingArray", :value 196617, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create uniform arrays of storage buffers or\n     * textures in shaders, if @ref WGPUNativeFeature_BufferBindingArray\n     * or @ref WGPUNativeFeature_TextureBindingArray (respectively)\n     * is also supported.\n     *\n     * This capability allows them to exist and to be indexed by dynamically\n     * uniform values.\n     *\n     * Supported platforms:\n     * - Metal (with MSL 2.2+ on macOS 10.13+)\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PartiallyBoundBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_PartiallyBoundBindingArray", :value 196618, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create bind groups containing arrays with fewer\n     * bindings than the @c WGPUBindGroupLayout requires.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureFormat16bitNorm", :type "CXType_Int", :name "WGPUNativeFeature_TextureFormat16bitNorm", :value 196619, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables normalized 16-bit texture formats:\n     * @ref WGPUTextureFormat_R16Unorm, @ref WGPUTextureFormat_R16Snorm,\n     * @ref WGPUTextureFormat_RG16Unorm, @ref WGPUTextureFormat_RG16Snorm,\n     * @ref WGPUTextureFormat_RGBA16Unorm, @ref WGPUTextureFormat_RGBA16Snorm.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureCompressionAstcHdr", :type "CXType_Int", :name "WGPUNativeFeature_TextureCompressionAstcHdr", :value 196620, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables ASTC HDR family of compressed textures.\n     *\n     * Compressed textures sacrifice some quality in exchange for\n     * significantly reduced bandwidth usage.\n     *\n     * Support for this feature guarantees availability of\n     * @c COPY_SRC | @c COPY_DST | @c TEXTURE_BINDING for ASTC formats\n     * with the HDR channel type.\n     * @ref WGPUNativeFeature_TextureAdapterSpecificFormatFeatures may\n     * enable additional usages.\n     *\n     * Supported platforms:\n     * - Metal\n     * - Vulkan\n     * - OpenGL\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MappablePrimaryBuffers", :type "CXType_Int", :name "WGPUNativeFeature_MappablePrimaryBuffers", :value 196622, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Removes the WebGPU restriction that @c MAP_READ and @c MAP_WRITE\n     * buffer usages must be paired exclusively with @c COPY_DST and\n     * @c COPY_SRC respectively.\n     *\n     * This is only beneficial on systems that share memory between CPU and\n     * GPU. If enabled on a system that doesn't, this can severely hinder\n     * performance. Only use if you understand the consequences.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_BufferBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_BufferBindingArray", :value 196623, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create arrays of buffers in shaders:\n     *\n     * - WGSL: @c var<uniform> @c buffer_array: @c array<MyBuffer, @c 10>\n     * - GLSL: @c uniform @c myBuffer @c { @c ... @c } @c buffer_array[10]\n     *\n     * This capability allows them to exist and to be indexed by dynamically\n     * uniform values.\n     *\n     * If @ref WGPUNativeFeature_StorageResourceBindingArray is supported as\n     * well as this, the user may also create arrays of storage buffers.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_StorageTextureArrayNonUniformIndexing", :type "CXType_Int", :name "WGPUNativeFeature_StorageTextureArrayNonUniformIndexing", :value 196624, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to index storage texture resource\n     * arrays with dynamically non-uniform values.\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_AddressModeClampToZero", :type "CXType_Int", :name "WGPUNativeFeature_AddressModeClampToZero", :value 196625, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to index storage texture resource\n     * arrays with dynamically non-uniform values.\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_AddressModeClampToBorder", :type "CXType_Int", :name "WGPUNativeFeature_AddressModeClampToBorder", :value 196626, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to index storage texture resource\n     * arrays with dynamically non-uniform values.\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PolygonModeLine", :type "CXType_Int", :name "WGPUNativeFeature_PolygonModeLine", :value 196627, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to set @ref WGPUPolygonMode_Line in\n     * @ref WGPUPrimitiveStateExtras::polygonMode.\n     *\n     * This allows drawing polygons/triangles as lines (wireframe) instead\n     * of filled.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PolygonModePoint", :type "CXType_Int", :name "WGPUNativeFeature_PolygonModePoint", :value 196628, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to set @ref WGPUPolygonMode_Point in\n     * @ref WGPUPrimitiveStateExtras::polygonMode.\n     *\n     * This allows only drawing the vertices of polygons/triangles instead\n     * of filled.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ConservativeRasterization", :type "CXType_Int", :name "WGPUNativeFeature_ConservativeRasterization", :value 196629, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to enable overestimation conservative rasterization\n     * via @ref WGPUPrimitiveStateExtras::conservative.\n     *\n     * Processing of degenerate triangles/lines is hardware specific.\n     * Only triangles are supported.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ClearTexture", :type "CXType_Int", :name "WGPUNativeFeature_ClearTexture", :value 196630, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables clear to zero for textures.\n     *\n     * Supported platforms:\n     * - All\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_Multiview", :type "CXType_Int", :name "WGPUNativeFeature_Multiview", :value 196632, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables multiview render passes and `builtin(view_index)` in vertex/mesh shaders.\n     * \n     * Supported platforms:\n     * - Vulkan\n     * - Metal\n     * - DX12\n     * - OpenGL (web only)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_VertexAttribute64bit", :type "CXType_Int", :name "WGPUNativeFeature_VertexAttribute64bit", :value 196633, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables using 64-bit types for vertex attributes.\n     *\n     * Requires @ref WGPUNativeFeature_ShaderF64.\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureFormatNv12", :type "CXType_Int", :name "WGPUNativeFeature_TextureFormatNv12", :value 196634, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for creation of textures of format\n     * @ref WGPUNativeTextureFormat_NV12.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_RayQuery", :type "CXType_Int", :name "WGPUNativeFeature_RayQuery", :value 196636, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for the creation of ray-tracing queries within shaders.\n     *\n     * @b EXPERIMENTAL: Features enabled by this may have major bugs and are\n     * expected to be subject to breaking changes.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderF64", :type "CXType_Int", :name "WGPUNativeFeature_ShaderF64", :value 196637, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables 64-bit floating point types in SPIR-V shaders.\n     *\n     * Note: even when supported by GPU hardware, 64-bit floating point\n     * operations are frequently between 16 and 64 @e times slower than\n     * equivalent operations on 32-bit floats.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderI16", :type "CXType_Int", :name "WGPUNativeFeature_ShaderI16", :value 196638, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use i16. Not currently supported in naga, only\n     * available through SPIR-V passthrough.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderEarlyDepthTest", :type "CXType_Int", :name "WGPUNativeFeature_ShaderEarlyDepthTest", :value 196640, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use the @c early_depth_test attribute.\n     *\n     * The attribute is applied to the fragment shader entry point and can be\n     * used in two ways:\n     *\n     * 1. Force early depth/stencil tests:\n     *    - WGSL: @c \\@early_depth_test(force)\n     *    - GLSL: @c layout(early_fragment_tests) @c in;\n     *\n     * 2. Provide a conservative depth specifier that allows an additional\n     *    early depth test under certain conditions:\n     *    - WGSL: @c \\@early_depth_test(greater_equal/less_equal/unchanged)\n     *    - GLSL: @c layout(depth_<greater/less/unchanged>) @c out @c float @c gl_FragDepth;\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - GLES 3.1+\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_Subgroup", :type "CXType_Int", :name "WGPUNativeFeature_Subgroup", :value 196641, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows compute and fragment shaders to use the subgroup operation\n     * built-ins and perform subgroup operations (except barriers).\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_SubgroupVertex", :type "CXType_Int", :name "WGPUNativeFeature_SubgroupVertex", :value 196642, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows vertex shaders to use the subgroup operation built-ins and\n     * perform subgroup operations (except barriers).\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_SubgroupBarrier", :type "CXType_Int", :name "WGPUNativeFeature_SubgroupBarrier", :value 196643, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows compute shaders to use the subgroup barrier.\n     *\n     * Requires @ref WGPUNativeFeature_Subgroup. Without it, enables nothing.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TimestampQueryInsideEncoders", :type "CXType_Int", :name "WGPUNativeFeature_TimestampQueryInsideEncoders", :value 196644, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for timestamp queries directly on command encoders.\n     *\n     * Implies @c WGPUFeatureName_TimestampQuery is supported.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     * - OpenGL (with GL_ARB_timer_query)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TimestampQueryInsidePasses", :type "CXType_Int", :name "WGPUNativeFeature_TimestampQueryInsidePasses", :value 196645, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for timestamp queries inside render and compute passes.\n     *\n     * Implies @c WGPUFeatureName_TimestampQuery and\n     * @ref WGPUNativeFeature_TimestampQueryInsideEncoders are supported.\n     *\n     * Enables @ref wgpuRenderPassEncoderWriteTimestamp and\n     * @ref wgpuComputePassEncoderWriteTimestamp.\n     *\n     * This is generally not available on tile-based rasterization GPUs.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal (AMD & Intel, not Apple GPUs)\n     * - OpenGL (with GL_ARB_timer_query)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderInt64", :type "CXType_Int", :name "WGPUNativeFeature_ShaderInt64", :value 196646, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use i64 and u64.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12 (DXC only)\n     * - Metal (with MSL 2.3+)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderFloat32Atomic", :type "CXType_Int", :name "WGPUNativeFeature_ShaderFloat32Atomic", :value 196647, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use f32 atomic load, store, add, sub, and exchange.\n     * \n     * Supported platforms:\n     * - Metal (with MSL 3.0+ and Apple7+/Mac2)\n     * - Vulkan (with [VK_EXT_shader_atomic_float])\n     *  \n     * This is a native only feature.\n    */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureAtomic", :type "CXType_Int", :name "WGPUNativeFeature_TextureAtomic", :value 196648, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables image atomic fetch add, and, xor, or, min, and max for R32Uint and R32Sint textures.\n     * \n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal (with MSL 3.1+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureFormatP010", :type "CXType_Int", :name "WGPUNativeFeature_TextureFormatP010", :value 196649, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for creation of textures of format\n     * @ref WGPUNativeTextureFormat_P010.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PipelineCache", :type "CXType_Int", :name "WGPUNativeFeature_PipelineCache", :value 196651, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the use of pipeline cache objects\n     * \n     * Supported platforms:\n     * - Vulkan\n     * \n     * Unimplemented Platforms:\n     * - DX12\n     * - Metal\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderInt64AtomicMinMax", :type "CXType_Int", :name "WGPUNativeFeature_ShaderInt64AtomicMinMax", :value 196652, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use i64 and u64 atomic min and max.\n     *\n     * Supported platforms:\n     * - Vulkan (with VK_KHR_shader_atomic_int64)\n     * - DX12 (with SM 6.6+)\n     * - Metal (with MSL 2.4+)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderInt64AtomicAllOps", :type "CXType_Int", :name "WGPUNativeFeature_ShaderInt64AtomicAllOps", :value 196653, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use all i64 and u64 atomic operations.\n     *\n     * Supported platforms:\n     * - Vulkan (with VK_KHR_shader_atomic_int64)\n     * - DX12 (with SM 6.6+)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureInt64Atomic", :type "CXType_Int", :name "WGPUNativeFeature_TextureInt64Atomic", :value 196656, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables R64Uint image atomic min and max.\n     * \n     * Supported platforms:\n     * - Vulkan (with VK_EXT_shader_image_atomic_int64)\n     * - DX12 (with SM 6.6+)\n     * - Metal (with MSL 3.1+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderBarycentrics", :type "CXType_Int", :name "WGPUNativeFeature_ShaderBarycentrics", :value 196663, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables shader barycentric coordinates.\n     * \n     * Supported platforms:\n     * - Vulkan (with VK_KHR_fragment_shader_barycentric)\n     * - DX12 (with SM 6.1+)\n     * - Metal (with MSL 2.2+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_SelectiveMultiview", :type "CXType_Int", :name "WGPUNativeFeature_SelectiveMultiview", :value 196664, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables using multiview where not all texture array layers are rendered to in a single render pass/render pipeline. Making\n     * use of this feature also requires enabling `Features::MULTIVIEW`.\n     * \n     * Supported platforms\n     * - Vulkan\n     * - DX12\n     * \n     * While metal supports this in theory, the behavior of `view_index` differs from vulkan and dx12 so the feature isn't exposed.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MultisampleArray", :type "CXType_Int", :name "WGPUNativeFeature_MultisampleArray", :value 196666, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables using multiview where not all texture array layers are rendered to in a single render pass/render pipeline. Making\n     * use of this feature also requires enabling `Features::MULTIVIEW`.\n     * \n     * Supported platforms\n     * - Vulkan\n     * - DX12\n     * \n     * While metal supports this in theory, the behavior of `view_index` differs from vulkan and dx12 so the feature isn't exposed.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_CooperativeMatrix", :type "CXType_Int", :name "WGPUNativeFeature_CooperativeMatrix", :value 196667, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables cooperative matrix operations (also known as tensor cores on NVIDIA GPUs\n     * or simdgroup matrix operations on Apple GPUs).\n     * \n     * Cooperative matrices allow a workgroup to collectively load, store, and perform\n     * matrix multiply-accumulate operations on small tiles of data, enabling\n     * hardware-accelerated matrix math.\n     *\n     * @b EXPERIMENTAL: Features enabled by this may have major bugs and are\n     * expected to be subject to breaking changes.\n     * \n     * **Current limitations:** The implementation currently only supports 8x8 f32 matrices.\n     * On Vulkan, support is determined by querying `vkGetPhysicalDeviceCooperativeMatrixPropertiesKHR`\n     * for configurations matching 8x8x8 f32. Most Vulkan implementations (NVIDIA, AMD) primarily\n     * support f16 inputs at larger sizes (e.g., 16x16), so Vulkan support may be limited.\n     * \n     * Supported platforms:\n     * - Metal (with MSL 2.3+ and Apple7+/Mac2+, using simdgroup matrix operations)\n     * - Vulkan (with [VK_KHR_cooperative_matrix](https://registry.khronos.org/vulkan/specs/latest/man/html/VK_KHR_cooperative_matrix.html), if 8x8 f32 is supported)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderPerVertex", :type "CXType_Int", :name "WGPUNativeFeature_ShaderPerVertex", :value 196668, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables shader per-vertex attributes.\n     * \n     * Supported platforms:\n     * - Vulkan (with VK_KHR_fragment_shader_barycentric)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderDrawIndex", :type "CXType_Int", :name "WGPUNativeFeature_ShaderDrawIndex", :value 196669, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables shader `draw_index` builtin.\n     * \n     * Supported platforms:\n     * - GLES\n     * - Vulkan\n     * \n     * Potential platforms:\n     * - DX12\n     * - Metal\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_AccelerationStructureBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_AccelerationStructureBindingArray", :value 196670, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create arrays of acceleration structures in shaders:\n     * \n     * ex.\n     * - `var tlas: binding_array<acceleration_structure, 10>` (WGSL)\n     * \n     * This capability allows them to exist and to be indexed by dynamically uniform values.\n     * \n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MemoryDecorationCoherent", :type "CXType_Int", :name "WGPUNativeFeature_MemoryDecorationCoherent", :value 196671, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables the `@coherent` memory decoration on storage buffer variables.\n     * \n     * Backend mapping:\n     * - Vulkan\n     * - DX12\n     * - Metal (3.2+)\n     * - GLES (ES 3.1+ / GL 4.3+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MemoryDecorationVolatile", :type "CXType_Int", :name "WGPUNativeFeature_MemoryDecorationVolatile", :value 196672, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables the `@volatile` memory decoration on storage buffer variables.\n     * \n     * Backend mapping:\n     * - Vulkan\n     * - GLES (ES 3.1+ / GL 4.3+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_Force32", :type "CXType_Int", :name "WGPUNativeFeature_Force32", :value 2147483647, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables the `@volatile` memory decoration on storage buffer variables.\n     * \n     * Backend mapping:\n     * - Vulkan\n     * - GLES (ES 3.1+ / GL 4.3+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_Immediates", :type "CXType_Int", :name "WGPUNativeFeature_Immediates", :value 196609, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the use of immediate data: small, fast blocks of memory\n     * that can be updated inside a render pass, compute pass, or render\n     * bundle encoder.\n     *\n     * Enables @ref wgpuRenderPassEncoderSetImmediates,\n     * @ref wgpuComputePassEncoderSetImmediates,\n     * @ref wgpuRenderBundleEncoderSetImmediates,\n     * non-zero @c immediateSize in @ref WGPUPipelineLayout,\n     * and non-zero @c maxImmediateSize in @ref WGPULimits.\n     *\n     * A block of immediate data can be declared in WGSL with\n     * @c var<immediate>:\n     * @code\n     * struct Immediates { example: f32, }\n     * var<immediate> c: Immediates;\n     * @endcode\n     *\n     * In GLSL, this corresponds to @c layout(immediates) @c uniform @c Name @c {..}.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     * - Metal\n     * - OpenGL (emulated with uniforms)\n     * - WebGPU\n     *\n     * This is a web and native feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureAdapterSpecificFormatFeatures", :type "CXType_Int", :name "WGPUNativeFeature_TextureAdapterSpecificFormatFeatures", :value 196610, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables device-specific texture format features.\n     *\n     * By default only texture format properties as defined by the WebGPU\n     * specification are allowed. Enabling this feature flag extends the\n     * features of each format to the ones supported by the current device.\n     * Note that without this flag, read/write storage access is not allowed\n     * at all.\n     *\n     * This extension does not enable additional formats.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MultiDrawIndirectCount", :type "CXType_Int", :name "WGPUNativeFeature_MultiDrawIndirectCount", :value 196612, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the use of a buffer containing the actual number of draw calls.\n     *\n     * Enables @ref wgpuRenderPassEncoderMultiDrawIndirectCount and\n     * @ref wgpuRenderPassEncoderMultiDrawIndexedIndirectCount.\n     *\n     * This feature being present also implies that all calls to\n     * @ref wgpuRenderPassEncoderMultiDrawIndirect and\n     * @ref wgpuRenderPassEncoderMultiDrawIndexedIndirect are not being\n     * emulated with a series of @c draw_indirect calls.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan 1.2+ (or VK_KHR_draw_indirect_count)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_VertexWritableStorage", :type "CXType_Int", :name "WGPUNativeFeature_VertexWritableStorage", :value 196613, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables bindings of writable storage buffers and textures visible\n     * to vertex shaders.\n     *\n     * Note: some (tiled-based) platforms do not support vertex shaders\n     * with any side-effects.\n     *\n     * Supported platforms:\n     * - All\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_TextureBindingArray", :value 196614, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create uniform arrays of textures in shaders:\n     *\n     * - WGSL: @c var @c textures: @c binding_array<texture_2d<f32>, @c 10>\n     * - GLSL: @c uniform @c texture2D @c textures[10]\n     *\n     * If @ref WGPUNativeFeature_StorageResourceBindingArray is supported\n     * as well as this, the user may also create uniform arrays of storage\n     * textures.\n     *\n     * This capability allows them to exist and to be indexed by dynamically\n     * uniform values.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Metal (with MSL 2.0+ on macOS 10.13+)\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_SampledTextureAndStorageBufferArrayNonUniformIndexing", :type "CXType_Int", :name "WGPUNativeFeature_SampledTextureAndStorageBufferArrayNonUniformIndexing", :value 196615, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to index sampled texture and storage buffer resource\n     * arrays with dynamically non-uniform values:\n     *\n     * e.g. @c texture_array[vertex_data]\n     *\n     * In order to use this capability, the corresponding GLSL extension must\n     * be enabled:\n     *\n     * @c \\#extension @c GL_EXT_nonuniform_qualifier @c : @c require\n     *\n     * and then used either as @c nonuniformEXT qualifier in variable\n     * declaration or as @c nonuniformEXT constructor.\n     *\n     * WGSL and HLSL do not need any extension.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Metal (with MSL 2.0+ on macOS 10.13+)\n     * - Vulkan 1.2+ (or VK_EXT_descriptor_indexing)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PipelineStatisticsQuery", :type "CXType_Int", :name "WGPUNativeFeature_PipelineStatisticsQuery", :value 196616, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables use of Pipeline Statistics Queries. These queries report the\n     * count of various operations performed between the start and stop call.\n     *\n     * Use @ref wgpuRenderPassEncoderBeginPipelineStatisticsQuery /\n     * @ref wgpuRenderPassEncoderEndPipelineStatisticsQuery (or the compute\n     * pass equivalents) to start and stop a query.\n     *\n     * They must be resolved using @c wgpuCommandEncoderResolveQuerySet into\n     * a buffer. See @ref WGPUPipelineStatisticName for the list of available\n     * statistics.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_StorageResourceBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_StorageResourceBindingArray", :value 196617, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create uniform arrays of storage buffers or\n     * textures in shaders, if @ref WGPUNativeFeature_BufferBindingArray\n     * or @ref WGPUNativeFeature_TextureBindingArray (respectively)\n     * is also supported.\n     *\n     * This capability allows them to exist and to be indexed by dynamically\n     * uniform values.\n     *\n     * Supported platforms:\n     * - Metal (with MSL 2.2+ on macOS 10.13+)\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PartiallyBoundBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_PartiallyBoundBindingArray", :value 196618, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create bind groups containing arrays with fewer\n     * bindings than the @c WGPUBindGroupLayout requires.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureFormat16bitNorm", :type "CXType_Int", :name "WGPUNativeFeature_TextureFormat16bitNorm", :value 196619, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables normalized 16-bit texture formats:\n     * @ref WGPUTextureFormat_R16Unorm, @ref WGPUTextureFormat_R16Snorm,\n     * @ref WGPUTextureFormat_RG16Unorm, @ref WGPUTextureFormat_RG16Snorm,\n     * @ref WGPUTextureFormat_RGBA16Unorm, @ref WGPUTextureFormat_RGBA16Snorm.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureCompressionAstcHdr", :type "CXType_Int", :name "WGPUNativeFeature_TextureCompressionAstcHdr", :value 196620, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables ASTC HDR family of compressed textures.\n     *\n     * Compressed textures sacrifice some quality in exchange for\n     * significantly reduced bandwidth usage.\n     *\n     * Support for this feature guarantees availability of\n     * @c COPY_SRC | @c COPY_DST | @c TEXTURE_BINDING for ASTC formats\n     * with the HDR channel type.\n     * @ref WGPUNativeFeature_TextureAdapterSpecificFormatFeatures may\n     * enable additional usages.\n     *\n     * Supported platforms:\n     * - Metal\n     * - Vulkan\n     * - OpenGL\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MappablePrimaryBuffers", :type "CXType_Int", :name "WGPUNativeFeature_MappablePrimaryBuffers", :value 196622, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Removes the WebGPU restriction that @c MAP_READ and @c MAP_WRITE\n     * buffer usages must be paired exclusively with @c COPY_DST and\n     * @c COPY_SRC respectively.\n     *\n     * This is only beneficial on systems that share memory between CPU and\n     * GPU. If enabled on a system that doesn't, this can severely hinder\n     * performance. Only use if you understand the consequences.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_BufferBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_BufferBindingArray", :value 196623, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create arrays of buffers in shaders:\n     *\n     * - WGSL: @c var<uniform> @c buffer_array: @c array<MyBuffer, @c 10>\n     * - GLSL: @c uniform @c myBuffer @c { @c ... @c } @c buffer_array[10]\n     *\n     * This capability allows them to exist and to be indexed by dynamically\n     * uniform values.\n     *\n     * If @ref WGPUNativeFeature_StorageResourceBindingArray is supported as\n     * well as this, the user may also create arrays of storage buffers.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_StorageTextureArrayNonUniformIndexing", :type "CXType_Int", :name "WGPUNativeFeature_StorageTextureArrayNonUniformIndexing", :value 196624, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to index storage texture resource\n     * arrays with dynamically non-uniform values.\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_AddressModeClampToZero", :type "CXType_Int", :name "WGPUNativeFeature_AddressModeClampToZero", :value 196625, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to index storage texture resource\n     * arrays with dynamically non-uniform values.\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_AddressModeClampToBorder", :type "CXType_Int", :name "WGPUNativeFeature_AddressModeClampToBorder", :value 196626, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to index storage texture resource\n     * arrays with dynamically non-uniform values.\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PolygonModeLine", :type "CXType_Int", :name "WGPUNativeFeature_PolygonModeLine", :value 196627, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to set @ref WGPUPolygonMode_Line in\n     * @ref WGPUPrimitiveStateExtras::polygonMode.\n     *\n     * This allows drawing polygons/triangles as lines (wireframe) instead\n     * of filled.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PolygonModePoint", :type "CXType_Int", :name "WGPUNativeFeature_PolygonModePoint", :value 196628, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to set @ref WGPUPolygonMode_Point in\n     * @ref WGPUPrimitiveStateExtras::polygonMode.\n     *\n     * This allows only drawing the vertices of polygons/triangles instead\n     * of filled.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ConservativeRasterization", :type "CXType_Int", :name "WGPUNativeFeature_ConservativeRasterization", :value 196629, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to enable overestimation conservative rasterization\n     * via @ref WGPUPrimitiveStateExtras::conservative.\n     *\n     * Processing of degenerate triangles/lines is hardware specific.\n     * Only triangles are supported.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ClearTexture", :type "CXType_Int", :name "WGPUNativeFeature_ClearTexture", :value 196630, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables clear to zero for textures.\n     *\n     * Supported platforms:\n     * - All\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_Multiview", :type "CXType_Int", :name "WGPUNativeFeature_Multiview", :value 196632, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables multiview render passes and `builtin(view_index)` in vertex/mesh shaders.\n     * \n     * Supported platforms:\n     * - Vulkan\n     * - Metal\n     * - DX12\n     * - OpenGL (web only)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_VertexAttribute64bit", :type "CXType_Int", :name "WGPUNativeFeature_VertexAttribute64bit", :value 196633, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables using 64-bit types for vertex attributes.\n     *\n     * Requires @ref WGPUNativeFeature_ShaderF64.\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureFormatNv12", :type "CXType_Int", :name "WGPUNativeFeature_TextureFormatNv12", :value 196634, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for creation of textures of format\n     * @ref WGPUNativeTextureFormat_NV12.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_RayQuery", :type "CXType_Int", :name "WGPUNativeFeature_RayQuery", :value 196636, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for the creation of ray-tracing queries within shaders.\n     *\n     * @b EXPERIMENTAL: Features enabled by this may have major bugs and are\n     * expected to be subject to breaking changes.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderF64", :type "CXType_Int", :name "WGPUNativeFeature_ShaderF64", :value 196637, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables 64-bit floating point types in SPIR-V shaders.\n     *\n     * Note: even when supported by GPU hardware, 64-bit floating point\n     * operations are frequently between 16 and 64 @e times slower than\n     * equivalent operations on 32-bit floats.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderI16", :type "CXType_Int", :name "WGPUNativeFeature_ShaderI16", :value 196638, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use i16. Not currently supported in naga, only\n     * available through SPIR-V passthrough.\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderEarlyDepthTest", :type "CXType_Int", :name "WGPUNativeFeature_ShaderEarlyDepthTest", :value 196640, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use the @c early_depth_test attribute.\n     *\n     * The attribute is applied to the fragment shader entry point and can be\n     * used in two ways:\n     *\n     * 1. Force early depth/stencil tests:\n     *    - WGSL: @c \\@early_depth_test(force)\n     *    - GLSL: @c layout(early_fragment_tests) @c in;\n     *\n     * 2. Provide a conservative depth specifier that allows an additional\n     *    early depth test under certain conditions:\n     *    - WGSL: @c \\@early_depth_test(greater_equal/less_equal/unchanged)\n     *    - GLSL: @c layout(depth_<greater/less/unchanged>) @c out @c float @c gl_FragDepth;\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - GLES 3.1+\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_Subgroup", :type "CXType_Int", :name "WGPUNativeFeature_Subgroup", :value 196641, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows compute and fragment shaders to use the subgroup operation\n     * built-ins and perform subgroup operations (except barriers).\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_SubgroupVertex", :type "CXType_Int", :name "WGPUNativeFeature_SubgroupVertex", :value 196642, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows vertex shaders to use the subgroup operation built-ins and\n     * perform subgroup operations (except barriers).\n     *\n     * Supported platforms:\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_SubgroupBarrier", :type "CXType_Int", :name "WGPUNativeFeature_SubgroupBarrier", :value 196643, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows compute shaders to use the subgroup barrier.\n     *\n     * Requires @ref WGPUNativeFeature_Subgroup. Without it, enables nothing.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - Metal\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TimestampQueryInsideEncoders", :type "CXType_Int", :name "WGPUNativeFeature_TimestampQueryInsideEncoders", :value 196644, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for timestamp queries directly on command encoders.\n     *\n     * Implies @c WGPUFeatureName_TimestampQuery is supported.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal\n     * - OpenGL (with GL_ARB_timer_query)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TimestampQueryInsidePasses", :type "CXType_Int", :name "WGPUNativeFeature_TimestampQueryInsidePasses", :value 196645, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for timestamp queries inside render and compute passes.\n     *\n     * Implies @c WGPUFeatureName_TimestampQuery and\n     * @ref WGPUNativeFeature_TimestampQueryInsideEncoders are supported.\n     *\n     * Enables @ref wgpuRenderPassEncoderWriteTimestamp and\n     * @ref wgpuComputePassEncoderWriteTimestamp.\n     *\n     * This is generally not available on tile-based rasterization GPUs.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal (AMD & Intel, not Apple GPUs)\n     * - OpenGL (with GL_ARB_timer_query)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderInt64", :type "CXType_Int", :name "WGPUNativeFeature_ShaderInt64", :value 196646, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use i64 and u64.\n     *\n     * Supported platforms:\n     * - Vulkan\n     * - DX12 (DXC only)\n     * - Metal (with MSL 2.3+)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderFloat32Atomic", :type "CXType_Int", :name "WGPUNativeFeature_ShaderFloat32Atomic", :value 196647, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use f32 atomic load, store, add, sub, and exchange.\n     * \n     * Supported platforms:\n     * - Metal (with MSL 3.0+ and Apple7+/Mac2)\n     * - Vulkan (with [VK_EXT_shader_atomic_float])\n     *  \n     * This is a native only feature.\n    */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureAtomic", :type "CXType_Int", :name "WGPUNativeFeature_TextureAtomic", :value 196648, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables image atomic fetch add, and, xor, or, min, and max for R32Uint and R32Sint textures.\n     * \n     * Supported platforms:\n     * - Vulkan\n     * - DX12\n     * - Metal (with MSL 3.1+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureFormatP010", :type "CXType_Int", :name "WGPUNativeFeature_TextureFormatP010", :value 196649, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows for creation of textures of format\n     * @ref WGPUNativeTextureFormat_P010.\n     *\n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_PipelineCache", :type "CXType_Int", :name "WGPUNativeFeature_PipelineCache", :value 196651, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the use of pipeline cache objects\n     * \n     * Supported platforms:\n     * - Vulkan\n     * \n     * Unimplemented Platforms:\n     * - DX12\n     * - Metal\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderInt64AtomicMinMax", :type "CXType_Int", :name "WGPUNativeFeature_ShaderInt64AtomicMinMax", :value 196652, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use i64 and u64 atomic min and max.\n     *\n     * Supported platforms:\n     * - Vulkan (with VK_KHR_shader_atomic_int64)\n     * - DX12 (with SM 6.6+)\n     * - Metal (with MSL 2.4+)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderInt64AtomicAllOps", :type "CXType_Int", :name "WGPUNativeFeature_ShaderInt64AtomicAllOps", :value 196653, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows shaders to use all i64 and u64 atomic operations.\n     *\n     * Supported platforms:\n     * - Vulkan (with VK_KHR_shader_atomic_int64)\n     * - DX12 (with SM 6.6+)\n     *\n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_TextureInt64Atomic", :type "CXType_Int", :name "WGPUNativeFeature_TextureInt64Atomic", :value 196656, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables R64Uint image atomic min and max.\n     * \n     * Supported platforms:\n     * - Vulkan (with VK_EXT_shader_image_atomic_int64)\n     * - DX12 (with SM 6.6+)\n     * - Metal (with MSL 3.1+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderBarycentrics", :type "CXType_Int", :name "WGPUNativeFeature_ShaderBarycentrics", :value 196663, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables shader barycentric coordinates.\n     * \n     * Supported platforms:\n     * - Vulkan (with VK_KHR_fragment_shader_barycentric)\n     * - DX12 (with SM 6.1+)\n     * - Metal (with MSL 2.2+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_SelectiveMultiview", :type "CXType_Int", :name "WGPUNativeFeature_SelectiveMultiview", :value 196664, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables using multiview where not all texture array layers are rendered to in a single render pass/render pipeline. Making\n     * use of this feature also requires enabling `Features::MULTIVIEW`.\n     * \n     * Supported platforms\n     * - Vulkan\n     * - DX12\n     * \n     * While metal supports this in theory, the behavior of `view_index` differs from vulkan and dx12 so the feature isn't exposed.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MultisampleArray", :type "CXType_Int", :name "WGPUNativeFeature_MultisampleArray", :value 196666, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables using multiview where not all texture array layers are rendered to in a single render pass/render pipeline. Making\n     * use of this feature also requires enabling `Features::MULTIVIEW`.\n     * \n     * Supported platforms\n     * - Vulkan\n     * - DX12\n     * \n     * While metal supports this in theory, the behavior of `view_index` differs from vulkan and dx12 so the feature isn't exposed.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_CooperativeMatrix", :type "CXType_Int", :name "WGPUNativeFeature_CooperativeMatrix", :value 196667, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables cooperative matrix operations (also known as tensor cores on NVIDIA GPUs\n     * or simdgroup matrix operations on Apple GPUs).\n     * \n     * Cooperative matrices allow a workgroup to collectively load, store, and perform\n     * matrix multiply-accumulate operations on small tiles of data, enabling\n     * hardware-accelerated matrix math.\n     *\n     * @b EXPERIMENTAL: Features enabled by this may have major bugs and are\n     * expected to be subject to breaking changes.\n     * \n     * **Current limitations:** The implementation currently only supports 8x8 f32 matrices.\n     * On Vulkan, support is determined by querying `vkGetPhysicalDeviceCooperativeMatrixPropertiesKHR`\n     * for configurations matching 8x8x8 f32. Most Vulkan implementations (NVIDIA, AMD) primarily\n     * support f16 inputs at larger sizes (e.g., 16x16), so Vulkan support may be limited.\n     * \n     * Supported platforms:\n     * - Metal (with MSL 2.3+ and Apple7+/Mac2+, using simdgroup matrix operations)\n     * - Vulkan (with [VK_KHR_cooperative_matrix](https://registry.khronos.org/vulkan/specs/latest/man/html/VK_KHR_cooperative_matrix.html), if 8x8 f32 is supported)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderPerVertex", :type "CXType_Int", :name "WGPUNativeFeature_ShaderPerVertex", :value 196668, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables shader per-vertex attributes.\n     * \n     * Supported platforms:\n     * - Vulkan (with VK_KHR_fragment_shader_barycentric)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_ShaderDrawIndex", :type "CXType_Int", :name "WGPUNativeFeature_ShaderDrawIndex", :value 196669, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables shader `draw_index` builtin.\n     * \n     * Supported platforms:\n     * - GLES\n     * - Vulkan\n     * \n     * Potential platforms:\n     * - DX12\n     * - Metal\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_AccelerationStructureBindingArray", :type "CXType_Int", :name "WGPUNativeFeature_AccelerationStructureBindingArray", :value 196670, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Allows the user to create arrays of acceleration structures in shaders:\n     * \n     * ex.\n     * - `var tlas: binding_array<acceleration_structure, 10>` (WGSL)\n     * \n     * This capability allows them to exist and to be indexed by dynamically uniform values.\n     * \n     * Supported platforms:\n     * - DX12\n     * - Vulkan\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MemoryDecorationCoherent", :type "CXType_Int", :name "WGPUNativeFeature_MemoryDecorationCoherent", :value 196671, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables the `@coherent` memory decoration on storage buffer variables.\n     * \n     * Backend mapping:\n     * - Vulkan\n     * - DX12\n     * - Metal (3.2+)\n     * - GLES (ES 3.1+ / GL 4.3+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_MemoryDecorationVolatile", :type "CXType_Int", :name "WGPUNativeFeature_MemoryDecorationVolatile", :value 196672, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables the `@volatile` memory decoration on storage buffer variables.\n     * \n     * Backend mapping:\n     * - Vulkan\n     * - GLES (ES 3.1+ / GL 4.3+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUNativeFeature_Force32", :type "CXType_Int", :name "WGPUNativeFeature_Force32", :value 2147483647, :enum "WGPUNativeFeature", :raw-comment "/**\n     * Enables the `@volatile` memory decoration on storage buffer variables.\n     * \n     * Backend mapping:\n     * - Vulkan\n     * - GLES (ES 3.1+ / GL 4.3+)\n     * \n     * This is a native only feature.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Off", :type "CXType_Int", :name "WGPULogLevel_Off", :value 0, :enum "WGPULogLevel", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Error", :type "CXType_Int", :name "WGPULogLevel_Error", :value 1, :enum "WGPULogLevel", :raw-comment "/** Only error messages. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Warn", :type "CXType_Int", :name "WGPULogLevel_Warn", :value 2, :enum "WGPULogLevel", :raw-comment "/** Errors and warnings. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Info", :type "CXType_Int", :name "WGPULogLevel_Info", :value 3, :enum "WGPULogLevel", :raw-comment "/** Errors, warnings, and informational messages. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Debug", :type "CXType_Int", :name "WGPULogLevel_Debug", :value 4, :enum "WGPULogLevel", :raw-comment "/** Errors, warnings, informational, and debug messages. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Trace", :type "CXType_Int", :name "WGPULogLevel_Trace", :value 5, :enum "WGPULogLevel", :raw-comment "/** All messages, including very verbose trace-level output. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Force32", :type "CXType_Int", :name "WGPULogLevel_Force32", :value 2147483647, :enum "WGPULogLevel", :raw-comment "/** All messages, including very verbose trace-level output. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Off", :type "CXType_Int", :name "WGPULogLevel_Off", :value 0, :enum "WGPULogLevel", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Error", :type "CXType_Int", :name "WGPULogLevel_Error", :value 1, :enum "WGPULogLevel", :raw-comment "/** Only error messages. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Warn", :type "CXType_Int", :name "WGPULogLevel_Warn", :value 2, :enum "WGPULogLevel", :raw-comment "/** Errors and warnings. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Info", :type "CXType_Int", :name "WGPULogLevel_Info", :value 3, :enum "WGPULogLevel", :raw-comment "/** Errors, warnings, and informational messages. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Debug", :type "CXType_Int", :name "WGPULogLevel_Debug", :value 4, :enum "WGPULogLevel", :raw-comment "/** Errors, warnings, informational, and debug messages. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Trace", :type "CXType_Int", :name "WGPULogLevel_Trace", :value 5, :enum "WGPULogLevel", :raw-comment "/** All messages, including very verbose trace-level output. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPULogLevel_Force32", :type "CXType_Int", :name "WGPULogLevel_Force32", :value 2147483647, :enum "WGPULogLevel", :raw-comment "/** All messages, including very verbose trace-level output. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUDx12Compiler_Undefined", :type "CXType_Int", :name "WGPUDx12Compiler_Undefined", :value 0, :enum "WGPUDx12Compiler", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUDx12Compiler_Fxc", :type "CXType_Int", :name "WGPUDx12Compiler_Fxc", :value 1, :enum "WGPUDx12Compiler", :raw-comment "/**\n     * Use the FXC (D3DCompile) shader compiler.\n     *\n     * The FXC compiler is old, slow, and unmaintained. However, it doesn't\n     * require any additional DLLs to be shipped with the application.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUDx12Compiler_Dxc", :type "CXType_Int", :name "WGPUDx12Compiler_Dxc", :value 2, :enum "WGPUDx12Compiler", :raw-comment "/**\n     * Use the DXC (DirectX Shader Compiler).\n     *\n     * The DXC compiler is new, fast, and maintained. However, it requires\n     * @c dxcompiler.dll to be available. The path to this DLL can be\n     * specified via @ref WGPUInstanceExtras::dxcPath.\n     *\n     * Minimum supported version: v1.8.2502.\n     * Requires WDDM 2.1 (Windows 10 version 1607).\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUDx12Compiler_Force32", :type "CXType_Int", :name "WGPUDx12Compiler_Force32", :value 2147483647, :enum "WGPUDx12Compiler", :raw-comment "/**\n     * Use the DXC (DirectX Shader Compiler).\n     *\n     * The DXC compiler is new, fast, and maintained. However, it requires\n     * @c dxcompiler.dll to be available. The path to this DLL can be\n     * specified via @ref WGPUInstanceExtras::dxcPath.\n     *\n     * Minimum supported version: v1.8.2502.\n     * Requires WDDM 2.1 (Windows 10 version 1607).\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUDx12Compiler_Undefined", :type "CXType_Int", :name "WGPUDx12Compiler_Undefined", :value 0, :enum "WGPUDx12Compiler", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUDx12Compiler_Fxc", :type "CXType_Int", :name "WGPUDx12Compiler_Fxc", :value 1, :enum "WGPUDx12Compiler", :raw-comment "/**\n     * Use the FXC (D3DCompile) shader compiler.\n     *\n     * The FXC compiler is old, slow, and unmaintained. However, it doesn't\n     * require any additional DLLs to be shipped with the application.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUDx12Compiler_Dxc", :type "CXType_Int", :name "WGPUDx12Compiler_Dxc", :value 2, :enum "WGPUDx12Compiler", :raw-comment "/**\n     * Use the DXC (DirectX Shader Compiler).\n     *\n     * The DXC compiler is new, fast, and maintained. However, it requires\n     * @c dxcompiler.dll to be available. The path to this DLL can be\n     * specified via @ref WGPUInstanceExtras::dxcPath.\n     *\n     * Minimum supported version: v1.8.2502.\n     * Requires WDDM 2.1 (Windows 10 version 1607).\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUDx12Compiler_Force32", :type "CXType_Int", :name "WGPUDx12Compiler_Force32", :value 2147483647, :enum "WGPUDx12Compiler", :raw-comment "/**\n     * Use the DXC (DirectX Shader Compiler).\n     *\n     * The DXC compiler is new, fast, and maintained. However, it requires\n     * @c dxcompiler.dll to be available. The path to this DLL can be\n     * specified via @ref WGPUInstanceExtras::dxcPath.\n     *\n     * Minimum supported version: v1.8.2502.\n     * Requires WDDM 2.1 (Windows 10 version 1607).\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Automatic", :type "CXType_Int", :name "WGPUGles3MinorVersion_Automatic", :value 0, :enum "WGPUGles3MinorVersion", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Version0", :type "CXType_Int", :name "WGPUGles3MinorVersion_Version0", :value 1, :enum "WGPUGles3MinorVersion", :raw-comment "/** Request an ES 3.0 context. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Version1", :type "CXType_Int", :name "WGPUGles3MinorVersion_Version1", :value 2, :enum "WGPUGles3MinorVersion", :raw-comment "/** Request an ES 3.1 context. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Version2", :type "CXType_Int", :name "WGPUGles3MinorVersion_Version2", :value 3, :enum "WGPUGles3MinorVersion", :raw-comment "/** Request an ES 3.2 context. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Force32", :type "CXType_Int", :name "WGPUGles3MinorVersion_Force32", :value 2147483647, :enum "WGPUGles3MinorVersion", :raw-comment "/** Request an ES 3.2 context. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Automatic", :type "CXType_Int", :name "WGPUGles3MinorVersion_Automatic", :value 0, :enum "WGPUGles3MinorVersion", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Version0", :type "CXType_Int", :name "WGPUGles3MinorVersion_Version0", :value 1, :enum "WGPUGles3MinorVersion", :raw-comment "/** Request an ES 3.0 context. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Version1", :type "CXType_Int", :name "WGPUGles3MinorVersion_Version1", :value 2, :enum "WGPUGles3MinorVersion", :raw-comment "/** Request an ES 3.1 context. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Version2", :type "CXType_Int", :name "WGPUGles3MinorVersion_Version2", :value 3, :enum "WGPUGles3MinorVersion", :raw-comment "/** Request an ES 3.2 context. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUGles3MinorVersion_Force32", :type "CXType_Int", :name "WGPUGles3MinorVersion_Force32", :value 2147483647, :enum "WGPUGles3MinorVersion", :raw-comment "/** Request an ES 3.2 context. */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPipelineStatisticName_VertexShaderInvocations", :type "CXType_Int", :name "WGPUPipelineStatisticName_VertexShaderInvocation
Space_Force32", :type "CXType_Int", :name "WGPUPredefinedColorSpace_Force32", :value 2147483647, :enum "WGPUPredefinedColorSpace", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPredefinedColorSpace_SRGB", :type "CXType_Int", :name "WGPUPredefinedColorSpace_SRGB", :value 1, :enum "WGPUPredefinedColorSpace", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPredefinedColorSpace_DisplayP3", :type "CXType_Int", :name "WGPUPredefinedColorSpace_DisplayP3", :value 2, :enum "WGPUPredefinedColorSpace", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPredefinedColorSpace_Force32", :type "CXType_Int", :name "WGPUPredefinedColorSpace_Force32", :value 2147483647, :enum "WGPUPredefinedColorSpace", :raw-comment nil} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Undefined", :type "CXType_Int", :name "WGPUPresentMode_Undefined", :value 0, :enum "WGPUPresentMode", :raw-comment "/**\n     * `0`. Present mode is not specified. Use the default.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Fifo", :type "CXType_Int", :name "WGPUPresentMode_Fifo", :value 1, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user waits for the next vertical blanking period to update in a first-in, first-out manner.\n     * Tearing cannot be observed and frame-loop will be limited to the display's refresh rate.\n     * This is the only mode that's always available.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_FifoRelaxed", :type "CXType_Int", :name "WGPUPresentMode_FifoRelaxed", :value 2, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user tries to wait for the next vertical blanking period but may decide to not wait if a frame is presented late.\n     * Tearing can sometimes be observed but late-frame don't produce a full-frame stutter in the presentation.\n     * This is still a first-in, first-out mechanism so a frame-loop will be limited to the display's refresh rate.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Immediate", :type "CXType_Int", :name "WGPUPresentMode_Immediate", :value 3, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user is updated immediately without waiting for a vertical blank.\n     * Tearing can be observed but latency is minimized.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Mailbox", :type "CXType_Int", :name "WGPUPresentMode_Mailbox", :value 4, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user waits for the next vertical blanking period to update to the latest provided image.\n     * Tearing cannot be observed and a frame-loop is not limited to the display's refresh rate.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Force32", :type "CXType_Int", :name "WGPUPresentMode_Force32", :value 2147483647, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user waits for the next vertical blanking period to update to the latest provided image.\n     * Tearing cannot be observed and a frame-loop is not limited to the display's refresh rate.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Undefined", :type "CXType_Int", :name "WGPUPresentMode_Undefined", :value 0, :enum "WGPUPresentMode", :raw-comment "/**\n     * `0`. Present mode is not specified. Use the default.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Fifo", :type "CXType_Int", :name "WGPUPresentMode_Fifo", :value 1, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user waits for the next vertical blanking period to update in a first-in, first-out manner.\n     * Tearing cannot be observed and frame-loop will be limited to the display's refresh rate.\n     * This is the only mode that's always available.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_FifoRelaxed", :type "CXType_Int", :name "WGPUPresentMode_FifoRelaxed", :value 2, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user tries to wait for the next vertical blanking period but may decide to not wait if a frame is presented late.\n     * Tearing can sometimes be observed but late-frame don't produce a full-frame stutter in the presentation.\n     * This is still a first-in, first-out mechanism so a frame-loop will be limited to the display's refresh rate.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Immediate", :type "CXType_Int", :name "WGPUPresentMode_Immediate", :value 3, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user is updated immediately without waiting for a vertical blank.\n     * Tearing can be observed but latency is minimized.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Mailbox", :type "CXType_Int", :name "WGPUPresentMode_Mailbox", :value 4, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user waits for the next vertical blanking period to update to the latest provided image.\n     * Tearing cannot be observed and a frame-loop is not limited to the display's refresh rate.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPresentMode_Force32", :type "CXType_Int", :name "WGPUPresentMode_Force32", :value 2147483647, :enum "WGPUPresentMode", :raw-comment "/**\n     * The presentation of the image to the user waits for the next vertical blanking period to update to the latest provided image.\n     * Tearing cannot be observed and a frame-loop is not limited to the display's refresh rate.\n     */"} {:kind "CXCursor_EnumConstantDecl", :spelling "WGPUPrimitiveTopology_Undefined", :type "CXType_Int", :name "WGPUPrimitiveTopology_Undefined", :value 0, :enum "WGPUP